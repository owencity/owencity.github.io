# Generate two different long passwords. Do not commit .env.
OWNER_USERNAME=owner
OWNER_PASSWORD=
DATABASE_PASSWORD=

# false for localhost / SSH tunnel; true when serving behind HTTPS.
COOKIE_SECURE=false
FEED_ENABLED=true
FEED_INTERVAL_MS=900000

# Calendar is optional. Only readonly event scope is needed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Disabled until explicitly configured and tested by the owner.
NOTIFICATIONS_ENABLED=false
DIGEST_SCHEDULED_ENABLED=false
DIGEST_CRON=0 0 8 * * *
SLACK_WEBHOOK_URL=
EMAIL_FROM=
EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
